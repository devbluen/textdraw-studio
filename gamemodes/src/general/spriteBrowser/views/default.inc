stock SpriteBrowserView_Hide(playerid) {
    for(new i = 0; i < sizeof TSPlayer[]; i++) {
        PlayerTextDrawDestroy(playerid, TSPlayer[playerid][i]);
        TSPlayer[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
    }
}

stock SpriteBrowserView_SetString(playerid, index, const string[])
    PlayerTextDrawSetString(playerid, TSPlayer[playerid][index], string);

stock SpriteBrowserView_SetClick(playerid, index, const callback[], params)
    PlayerTextDrawSetClick(playerid, callback, TSPlayer[playerid][index], params);

stock SpriteBrowserView_ShowItem(playerid, index)
    PlayerTextDrawShow(playerid, TSPlayer[playerid][index]);

stock SpriteBrowserView_HideItem(playerid, index)
    PlayerTextDrawHide(playerid, TSPlayer[playerid][index]);

stock SpriteBrowserView_SetSize(playerid, index, Float:x) {
    PlayerTextDrawTextSize(playerid, TSPlayer[playerid][index], x, 16.000000);
    PlayerTextDrawShow(playerid, TSPlayer[playerid][index]);
}

stock SpriteBrowserView_SetColor(playerid, index, color) {
    PlayerTextDrawColour(playerid, TSPlayer[playerid][index], color);
    PlayerTextDrawShow(playerid, TSPlayer[playerid][index]);
}